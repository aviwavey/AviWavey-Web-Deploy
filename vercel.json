{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/auth.ts": {
      "maxDuration": 30
    },
    "api/aura.ts": {
      "maxDuration": 120
    },
    "api/asset-preview.ts": {
      "maxDuration": 60
    },
    "api/directory-session.ts": {
      "maxDuration": 30
    },
    "api/toolkit.ts": {
      "maxDuration": 90
    },
    "api/notes.ts": {
      "maxDuration": 30
    },
    "api/tasksync.ts": {
      "maxDuration": 30
    },
    "api/identity.ts": {
      "maxDuration": 30
    },
    "api/capital.ts": {
      "maxDuration": 60
    },
    "api/support.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/support/(.*)",
      "dest": "/api/support.ts?route=$1"
    },
    {
      "src": "/api/capital/(.*)",
      "dest": "/api/capital.ts?route=$1"
    },
    {
      "src": "/api/identity/(.*)",
      "dest": "/api/identity.ts?route=$1"
    },
    {
      "src": "/api/tasksync/(.*)",
      "dest": "/api/tasksync.ts?route=$1"
    },
    {
      "src": "/api/notes/(.*)",
      "dest": "/api/notes.ts?route=$1"
    },
    {
      "src": "/api/toolkit/(.*)",
      "dest": "/api/toolkit.ts?route=$1"
    },
    {
      "src": "/api/directory-session/(.*)",
      "dest": "/api/directory-session.ts?route=$1"
    },
    {
      "src": "/api/asset-preview/(.*)",
      "dest": "/api/asset-preview.ts?route=$1"
    },
    {
      "src": "/api/aura/(.*)",
      "dest": "/api/aura.ts?route=$1"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.ts?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/auth.ts": {
      "maxDuration": 30
    },
    "api/aura.ts": {
      "maxDuration": 120
    },
    "api/asset-preview.ts": {
      "maxDuration": 60
    },
    "api/directory-session.ts": {
      "maxDuration": 30
    },
    "api/toolkit.ts": {
      "maxDuration": 90
    },
    "api/notes.ts": {
      "maxDuration": 30
    },
    "api/tasksync.ts": {
      "maxDuration": 30
    },
    "api/identity.ts": {
      "maxDuration": 30
    },
    "api/capital.ts": {
      "maxDuration": 60
    },
    "api/support.ts": {
      "maxDuration": 60
    },
    "api/social-link.ts": {
      "maxDuration": 30
    },
    "api/admin.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin.ts?route=$1"
    },
    {
      "src": "/administration(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/admin(?:/(.*))?",
      "status": 307,
      "headers": {
        "Location": "/administration/$1"
      }
    },
    {
      "src": "/admin\\.html",
      "status": 307,
      "headers": {
        "Location": "/administration"
      }
    },
    {
      "src": "/MikeT\\.MMT",
      "dest": "https://mike-t-mmt-web-deploy.vercel.app/MikeT.MMT"
    },
    {
      "src": "/MikeT\\.MMT/(.*)",
      "dest": "https://mike-t-mmt-web-deploy.vercel.app/MikeT.MMT/$1"
    },
    {
      "src": "/(?:mike-t|miket\\.mmt)(/.*)?",
      "status": 307,
      "headers": {
        "Location": "/MikeT.MMT$1"
      }
    },
    {
      "src": "/api/support/(.*)",
      "dest": "/api/support.ts?route=$1"
    },
    {
      "src": "/api/capital/(.*)",
      "dest": "/api/capital.ts?route=$1"
    },
    {
      "src": "/api/identity/(.*)",
      "dest": "/api/identity.ts?route=$1"
    },
    {
      "src": "/api/tasksync/(.*)",
      "dest": "/api/tasksync.ts?route=$1"
    },
    {
      "src": "/api/social-link/(.*)",
      "dest": "/api/social-link.ts?route=$1"
    },
    {
      "src": "/api/notes/(.*)",
      "dest": "/api/notes.ts?route=$1"
    },
    {
      "src": "/api/toolkit/(.*)",
      "dest": "/api/toolkit.ts?route=$1"
    },
    {
      "src": "/api/directory-session/(.*)",
      "dest": "/api/directory-session.ts?route=$1"
    },
    {
      "src": "/api/asset-preview/(.*)",
      "dest": "/api/asset-preview.ts?route=$1"
    },
    {
      "src": "/api/aura/(.*)",
      "dest": "/api/aura.ts?route=$1"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.ts?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/administration(?:/.*)?",
      "dest": "/administration/admin.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
